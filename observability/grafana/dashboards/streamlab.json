{
 "uid": "streamlab",
 "title": "StreamLab — pipeline de live streaming",
 "tags": [
  "streaming",
  "streamlab"
 ],
 "timezone": "browser",
 "schemaVersion": 41,
 "version": 1,
 "refresh": "5s",
 "editable": true,
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "type": "row",
   "title": "1 · Ingest — o sinal chegando do streamer (MediaMTX)",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Canais ao vivo",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Paths live/<canal> prontos no MediaMTX.",
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count(streamlab_channel_live == 1) or vector(0)",
     "legendFormat": "ao vivo"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value_and_name"
   }
  },
  {
   "type": "stat",
   "title": "Publicadores por protocolo",
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Conexões de ingest abertas por protocolo.",
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rtmp_conns{state=\"publish\"}) or vector(0)",
     "legendFormat": "RTMP"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(srt_conns{state=\"publish\"}) or vector(0)",
     "legendFormat": "SRT"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(webrtc_sessions{state=\"publish\"}) or vector(0)",
     "legendFormat": "WHIP"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value_and_name"
   }
  },
  {
   "type": "timeseries",
   "title": "Bitrate de ingest por canal",
   "id": 4,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Quanto o encoder (OBS) está enviando. Se oscila muito, a conexão de upload do streamer está ruim.",
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rate(paths_bytes_received{name=~\"live/.*\"}[30s]) * 8",
     "legendFormat": "{{name}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "SRT: RTT e perda de pacotes",
   "id": 5,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Só aparece com ingest SRT. SRT retransmite pacotes perdidos (ARQ) dentro da janela de latência configurada.",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "srt_conns_ms_rtt",
     "legendFormat": "RTT ms {{path}}"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "srt_conns_packets_received_loss_rate",
     "legendFormat": "perda % {{path}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Auth de stream key (MediaMTX → hub)",
   "id": 6,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Cada publish/leitura pergunta ao hub. 'publish deny' alto = alguém tentando chaves erradas.",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (action,result) (rate(streamlab_auth_requests_total[1m]))",
     "legendFormat": "{{action}} {{result}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "row",
   "title": "2 · Transcoding — a escada ABR (FFmpeg no hub)",
   "id": 7,
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 15,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Velocidade do transcoder (1.0 = tempo real)",
   "id": 8,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Abaixo de 1.0 o transcoder está ficando para trás: a CPU não dá conta. É o alerta mais importante do pipeline.",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "streamlab_transcoder_speed_ratio",
     "legendFormat": "{{channel}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "x",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never",
      "thresholdsStyle": {
       "mode": "line"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 0.97
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "FPS processados",
   "id": 9,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Deveria acompanhar o FPS da fonte (30 no demo).",
   "gridPos": {
    "x": 8,
    "y": 16,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "streamlab_transcoder_fps",
     "legendFormat": "{{channel}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "stat",
   "title": "Renditions / Restarts (1h)",
   "id": 10,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "",
   "gridPos": {
    "x": 16,
    "y": 16,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(streamlab_transcoder_renditions)",
     "legendFormat": "renditions"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "round(sum(increase(streamlab_transcoder_restarts_total[1h]))) or vector(0)",
     "legendFormat": "restarts"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value_and_name"
   }
  },
  {
   "type": "row",
   "title": "3 · Entrega — edge/CDN, LL-HLS e WebRTC",
   "id": 11,
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 23,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Requisições no edge (NGINX)",
   "id": 12,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Cada espectador HLS pede 1 playlist + 1 segmento a cada ~2s. Abra o DevTools e veja o header X-Cache (HIT/MISS).",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rate(nginx_http_requests_total[30s])",
     "legendFormat": "req/s"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Saída do MediaMTX por canal",
   "id": 13,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Inclui o transcoder (RTSP), LL-HLS e WebRTC. HLS ABR sai pelo edge, não por aqui.",
   "gridPos": {
    "x": 8,
    "y": 24,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rate(paths_bytes_sent{name=~\"live/.*\"}[30s]) * 8",
     "legendFormat": "{{name}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Leitores por tipo",
   "id": 14,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Quem está lendo direto do servidor de mídia.",
   "gridPos": {
    "x": 16,
    "y": 24,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (readerType) (paths_readers{name=~\"live/.*\",readerType!=\"\"})",
     "legendFormat": "{{readerType}}"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(webrtc_sessions{state=\"read\"}) or vector(0)",
     "legendFormat": "sessões WebRTC"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "row",
   "title": "4 · Audiência e QoE — o que o espectador sente (beacons do player)",
   "id": 15,
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 31,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Espectadores",
   "id": 16,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Conexões WebSocket abertas nas páginas dos canais.",
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 4,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(streamlab_viewers) or vector(0)",
     "legendFormat": "total"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value_and_name"
   }
  },
  {
   "type": "timeseries",
   "title": "Sessões de player por modo",
   "id": 17,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "hls = ABR via edge · llhls = Low-Latency HLS · webrtc = WHEP",
   "gridPos": {
    "x": 4,
    "y": 32,
    "w": 10,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (mode) (streamlab_player_sessions)",
     "legendFormat": "{{mode}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Latência ao vivo (p50) por modo",
   "id": 18,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Distância entre o que o player mostra e o 'agora'. HLS ~6-10s, LL-HLS ~2-3s, WebRTC < 1s.",
   "gridPos": {
    "x": 14,
    "y": 32,
    "w": 10,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le,mode) (rate(streamlab_player_latency_seconds_bucket[1m])))",
     "legendFormat": "{{mode}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Tempo de início (p50 / p95)",
   "id": 19,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Video Start Time: do clique ao primeiro quadro. Cada segundo a mais perde audiência.",
   "gridPos": {
    "x": 0,
    "y": 39,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le,mode) (rate(streamlab_player_startup_seconds_bucket[5m])))",
     "legendFormat": "p50 {{mode}}"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le,mode) (rate(streamlab_player_startup_seconds_bucket[5m])))",
     "legendFormat": "p95 {{mode}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Rebuffering ratio",
   "id": 20,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Fração do tempo assistido em que o vídeo ficou travado. A métrica de QoE mais importante. Meta: < 1%.",
   "gridPos": {
    "x": 8,
    "y": 39,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (channel,mode) (rate(streamlab_player_rebuffer_seconds_total[2m])) / sum by (channel,mode) (rate(streamlab_player_watch_seconds_total[2m]))",
     "legendFormat": "{{channel}} {{mode}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Bitrate assistido (p50) e trocas de qualidade",
   "id": 21,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "O ABR escolhendo a qualidade. Muitas trocas = oscilação (ruim para a experiência).",
   "gridPos": {
    "x": 16,
    "y": 39,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le,mode) (rate(streamlab_player_bitrate_kbps_bucket[2m])))",
     "legendFormat": "p50 kbps {{mode}}"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (direction) (rate(streamlab_player_quality_switches_total[2m])) * 60",
     "legendFormat": "trocas/min {{direction}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Buffer do player (p50)",
   "id": 22,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "",
   "gridPos": {
    "x": 0,
    "y": 47,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le,mode) (rate(streamlab_player_buffer_seconds_bucket[2m])))",
     "legendFormat": "{{mode}}"
